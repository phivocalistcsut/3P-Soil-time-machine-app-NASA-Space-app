# Optional. Used only by the manual live verification script.
STM_VERIFY_URL=

# Optional higher-volume address provider (server-side only).
# With no key, submit-only online search uses the public Photon/OSM service.
MAPTILER_API_KEY=

# Optional self-hosted/managed Photon endpoint for higher traffic.
# Default https://photon.komoot.io/api/ is a public demo with no availability SLA.
PHOTON_GEOCODING_URL=

# Optional road-map tile service override. Default OSM needs no key.
# Supply matching HTML attribution if changing providers. Browser-visible values.
NEXT_PUBLIC_STREET_TILE_URL=
NEXT_PUBLIC_STREET_TILE_ATTRIBUTION=

# POWER, ORNL, SMAP archive, GIBS and SoilGrids WCS require no app credentials.
